<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño 1.2.0: marco, logo, botones con imagen y menú lateral propuestos por Zemog, jugador de la comunidad.
     El marco (img/panel.png) se pinta a escala 0.47 (946x665); las cajas del Canvas siguen sus huecos:
     menú 35..186, centro 201..670, derecha 684..907 (estado arriba 122..294, avisos abajo 301..472), barra 505..653. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classic Forever" Width="960" Height="722"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" Foreground="#E6D9B8">
  <Window.Resources>
    <SolidColorBrush x:Key="Gold" Color="#E8C46A"/>
    <SolidColorBrush x:Key="Dim" Color="#A3967C"/>
    <SolidColorBrush x:Key="Body" Color="#D6CCB4"/>

    <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.9"/>

    <Style x:Key="ImageButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CP" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="14" Color="#E8C46A" ShadowDepth="0" Opacity="0.75"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CP" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#D8C7A3"/>
      <Setter Property="Background" Value="#50000000"/>
      <Setter Property="BorderBrush" Value="#6B5232"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#E8C46A"/>
                <Setter TargetName="B" Property="Background" Value="#80000000"/>
                <Setter Property="Foreground" Value="#FFF7D5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E8C46A"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                <Setter TargetName="T" Property="Foreground" Value="#FFF1D28A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#C4B593"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="7,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MinButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#C4B593"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="#70000000" BorderBrush="#8A6A3A" BorderThickness="1" CornerRadius="4">
              <Rectangle x:Name="Bar" Width="12" Height="2" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#E8C46A"/>
                <Setter TargetName="Bar" Property="Fill" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDE6D6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="12" Padding="11,4" Background="#50000000" BorderThickness="1" BorderBrush="#66E8C46A">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#CCE8C46A"/>
                <Setter TargetName="B" Property="Background" Value="#30E8C46A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BoxHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#E8C46A"/>
      <Setter Property="Effect" Value="{StaticResource TextShadow}"/>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Marco -->
    <Canvas x:Name="Frame" Width="946" Height="665" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,50,0,0">
      <Image x:Name="BgImage" Width="946" Height="665" Stretch="Fill"/>


      <!-- Menú lateral -->
      <StackPanel Canvas.Left="35" Canvas.Top="138" Width="151">
        <Button x:Name="BtnNewsNav" Style="{StaticResource ImageButton}" Margin="0,0,0,16">
          <StackPanel>
            <Image x:Name="NewsImg" Width="112" Height="60"/>
            <TextBlock x:Name="TxtNews" Text=" " FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnPatchNav" Style="{StaticResource ImageButton}" Margin="0,0,0,16">
          <StackPanel>
            <Image x:Name="PatchImg" Width="112" Height="60"/>
            <TextBlock x:Name="TxtPatch" Text=" " FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnSettingsNav" Style="{StaticResource ImageButton}">
          <StackPanel>
            <Image x:Name="SettingsImg" Width="112" Height="60"/>
            <TextBlock x:Name="TxtSettings" Text=" " FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Centro: Noticias / Notas del parche (misma lista) -->
      <DockPanel x:Name="FeedView" Canvas.Left="219" Canvas.Top="138" Width="433" Height="318">
        <TextBlock x:Name="NewsHeader" DockPanel.Dock="Top" Text=" " FontSize="14" Style="{StaticResource BoxHeader}" Margin="0,0,0,12"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Resources>
            <!-- barra fina dorada (la gris de Windows desentonaba con el cuero) -->
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="6"/>
              <Setter Property="MinWidth" Value="6"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                      <Border CornerRadius="3" Background="#40000000"/>
                      <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                          <Thumb Cursor="Hand">
                            <Thumb.Template>
                              <ControlTemplate TargetType="Thumb">
                                <Border x:Name="T" CornerRadius="3" Background="#99E8C46A"/>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#E8C46A"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Thumb.Template>
                          </Thumb>
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel x:Name="NewsList" Margin="0,0,8,0">
            <TextBlock x:Name="NewsPlaceholder" Text=" " Foreground="{StaticResource Dim}" FontSize="13"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Centro: Opciones -->
      <StackPanel x:Name="SettingsView" Canvas.Left="219" Canvas.Top="138" Width="433" Visibility="Collapsed">
        <TextBlock x:Name="SettingsHeader" Text=" " FontSize="14" Style="{StaticResource BoxHeader}" Margin="0,0,0,14"/>
        <TextBlock x:Name="FolderLabel" Text=" " FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}"/>
        <TextBlock x:Name="FolderText" Text="" FontSize="12.5" Foreground="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,2"/>
        <TextBlock x:Name="ClientText" Text="" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,10"/>
        <WrapPanel>
          <Button x:Name="FolderButton" Content=" " Style="{StaticResource FlatButton}"/>
          <Button x:Name="LogButton" Content=" " Style="{StaticResource FlatButton}"/>
        </WrapPanel>
        <TextBlock x:Name="CacheLabel" Text=" " FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" Margin="0,14,0,0"/>
        <TextBlock x:Name="CacheHint" Text=" " FontSize="12" Foreground="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,8"/>
        <WrapPanel>
          <Button x:Name="CacheButton" Content=" " Style="{StaticResource FlatButton}"/>
        </WrapPanel>
        <TextBlock x:Name="AddonsLabel" Text=" " FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" Margin="0,8,0,2"/>
        <CheckBox x:Name="AddonsCheck" Foreground="{StaticResource Body}" FontSize="12" Cursor="Hand">
          <TextBlock x:Name="AddonsCheckText" Text=" " Foreground="{StaticResource Body}"/>
        </CheckBox>
        <TextBlock x:Name="AddonsText" Text=" " FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        <!-- Campo de vision (Fov.cs): casilla + deslizador 60..150; se aplica en caliente mientras el juego esta abierto -->
        <TextBlock x:Name="FovLabel" Text=" " FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" Margin="0,10,0,2"/>
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="FovCheck" Foreground="{StaticResource Body}" FontSize="12" Cursor="Hand" VerticalAlignment="Center">
            <TextBlock x:Name="FovCheckText" Text=" " Foreground="{StaticResource Body}"/>
          </CheckBox>
          <Slider x:Name="FovSlider" Width="150" Minimum="60" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                  Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand"/>
          <TextBlock x:Name="FovValue" Text=" " Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Width="34"/>
        </StackPanel>
        <TextBlock x:Name="FovHint" Text=" " FontSize="11.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>

      <!-- Derecha arriba: estado del reino -->
      <StackPanel Canvas.Left="700" Canvas.Top="138" Width="191">
        <TextBlock x:Name="RealmHeader" Text=" " Style="{StaticResource BoxHeader}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal">
          <Grid Width="14" Height="14" VerticalAlignment="Center">
            <Ellipse x:Name="StatusHalo" Width="14" Height="14" Fill="#8A8A8A" Opacity="0.35" RenderTransformOrigin="0.5,0.5"/>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8A8A8A"/>
          </Grid>
          <TextBlock x:Name="StatusText" Text=" " Margin="9,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="168" Effect="{StaticResource TextShadow}"/>
        </StackPanel>
        <TextBlock x:Name="DetailText" Text=" " Margin="23,4,0,0" FontSize="12" Foreground="{StaticResource Body}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="23,8,0,0">
          <Ellipse x:Name="LoginDot" Width="7" Height="7" Fill="#555" VerticalAlignment="Center"/>
          <TextBlock x:Name="LoginLabel" Text="Login" Margin="5,0,12,0" FontSize="11.5" Foreground="{StaticResource Dim}"/>
          <Ellipse x:Name="WorldDot" Width="7" Height="7" Fill="#555" VerticalAlignment="Center"/>
          <TextBlock x:Name="WorldLabel" Text=" " Margin="5,0,0,0" FontSize="11.5" Foreground="{StaticResource Dim}"/>
        </StackPanel>
        <TextBlock x:Name="PingText" Text="" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="23,6,0,0"/>
        <TextBlock x:Name="MessageText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Gold}" Margin="0,10,0,0" Effect="{StaticResource TextShadow}"/>
      </StackPanel>

      <!-- Derecha abajo: aviso del servidor, launcher nuevo y enlaces -->
      <!-- Discord: la caja de encima de JUGAR (lo muestra status.json "discord") -->
      <Button x:Name="DiscordButton" Style="{StaticResource ImageButton}" Canvas.Left="741" Canvas.Top="318" Width="112" Height="83" Visibility="Collapsed">
        <Image x:Name="DiscordImg" Stretch="Uniform"/>
      </Button>
      <TextBlock x:Name="DiscordLabel" Canvas.Left="700" Canvas.Top="402" Width="195" TextAlignment="Center" Text=" " Visibility="Collapsed"
                 Style="{StaticResource BoxHeader}" FontSize="11.5" IsHitTestVisible="False"/>

      <ScrollViewer x:Name="RightBottom" Canvas.Left="700" Canvas.Top="316" Width="195" Height="146" VerticalScrollBarVisibility="Hidden">
        <StackPanel>
          <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="4" Padding="9,6" Margin="0,0,0,10" Background="#AA3A2A08" BorderBrush="#88E8C46A" BorderThickness="1">
            <StackPanel>
              <TextBlock x:Name="UpdateText" Text=" " FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="UpdateLink" Style="{StaticResource LinkButton}" Content=" " Margin="0,4,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="LinksHeader" Text=" " Style="{StaticResource BoxHeader}" Margin="0,0,0,8"/>
          <WrapPanel x:Name="LinksPanel"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Barra inferior -->
      <StackPanel Canvas.Left="52" Canvas.Top="528" Width="560">
        <TextBlock x:Name="StepText" Text=" " FontSize="15.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Effect="{StaticResource TextShadow}"/>
        <TextBlock x:Name="SubtitleText" Text=" " FontSize="12" Foreground="{StaticResource Dim}" Margin="0,10,0,0"/>
        <TextBlock x:Name="VersionText" Text=" " FontSize="11" Foreground="#7A6E58" FontWeight="SemiBold" Margin="0,3,0,0"/>
      </StackPanel>

      <Button x:Name="PlayButton" Style="{StaticResource ImageButton}" Canvas.Left="640" Canvas.Top="513" Width="262" Height="136">
        <Grid>
          <Image x:Name="PlayImg" Stretch="Uniform"/>
          <Border x:Name="PlayOverlay" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                  CornerRadius="4" Padding="12,3" Background="#C8120C06" BorderBrush="#88E8C46A" BorderThickness="1">
            <TextBlock x:Name="PlayOverlayText" Text=" " FontFamily="Palatino Linotype" FontSize="17" FontWeight="Bold" Foreground="#F6DA8C"/>
          </Border>
        </Grid>
      </Button>
    </Canvas>

    <!-- Logo y controles de ventana (por encima del marco) -->
    <Image x:Name="LogoImage" Width="172" Height="161" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="394,2,0,0" IsHitTestVisible="False">
      <Image.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Color="#000000" Opacity="0.8"/></Image.Effect>
    </Image>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
      <Border CornerRadius="4" Background="#90000000" BorderBrush="#8A6A3A" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="LangEs" Content="ES" Style="{StaticResource LangButton}" ToolTip="Español"/>
          <Button x:Name="LangEn" Content="EN" Style="{StaticResource LangButton}" ToolTip="English"/>
        </StackPanel>
      </Border>
      <Button x:Name="MinButton" Style="{StaticResource MinButton}" Width="30" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <Button x:Name="CloseButton" Style="{StaticResource ImageButton}" Width="34" Height="34" VerticalAlignment="Center">
        <Image x:Name="CloseImg" Stretch="Uniform"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
